{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "OpenDormConnectionString": "Host=localhost;Port=5432;Database=open_dorm_db;Username=open_dorm;Password=YOUR_SECRET_PASSWORD"
  },
  "Jwt": {
    "Issuer": "OpenDorm",
    "Audience": "OpenDorm.Client",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  }
}
